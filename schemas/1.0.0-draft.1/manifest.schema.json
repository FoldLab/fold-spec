{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fold-spec.example/schemas/1.0.0-draft.1/manifest.schema.json",
  "title": "Fold Spec package manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "fold-spec-package"
    },
    "specVersion": {
      "const": "1.0.0-draft.1"
    },
    "document": {
      "const": "document.json"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,239}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Lowercase SHA-256 of the exact stored bytes.",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "byteLength",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 257
    }
  },
  "required": [
    "format",
    "specVersion",
    "document",
    "entries"
  ],
  "additionalProperties": false
}
